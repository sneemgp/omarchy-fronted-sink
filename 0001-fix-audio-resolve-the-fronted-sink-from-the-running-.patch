From f5608cfb8497c1665981e3c364786e527a893be6 Mon Sep 17 00:00:00 2001
From: Hernan Ganzo <gp@sneemgp.com>
Date: Sun, 20 Sep 2026 19:06:29 +0100
Subject: [PATCH] fix(audio): resolve the fronted sink from the running graph,
 not only from a shipped tuning

`omarchy audio tuning fronted-sink` answers from the matched tuning's
sink_pattern, through tuned_hardware_sink. A tuning installed by hand -- one with
no directory under default/audio/tunings -- has no pattern to read, so the command
printed nothing and exited 1 while a tuning was installed and fronting.

Both consumers of that answer then stopped hiding the physical sink:
omarchy-audio-sink-availability reported it available, and
omarchy-audio-output-switch kept it as a rotation stop, so picking it bypasses the
tuning. That contradicts docs/audio-tuning.md, which states the fronted sink is
hidden, without qualifying the promise by where the tuning came from.

When no shipped tuning answers, resolve the physical sink from the installed
tuning's own output stream instead -- the resolution this script already has as
tuning_downstream_sink, which follows the filter-chain's stream down to the sink
underneath. The declaration stays the first answer, because it is the most
precise one when it exists; the graph is the fallback, not the replacement.

The guard matters: while the chain is idle or unlinked,
omarchy-audio-output-sink falls back to printing the sink it was given, and
reporting the tuning sink as the sink to hide would be worse than the bug.

The same resolution fixes a second consequence in `off`: removing a hand-installed
tuning previously left the default sink pointing at a sink that no longer existed,
because there was no physical sink to restore it to.
---
 bin/omarchy-audio-tuning | 28 ++++++++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/bin/omarchy-audio-tuning b/bin/omarchy-audio-tuning
index 75b301d..68bee40 100755
--- a/bin/omarchy-audio-tuning
+++ b/bin/omarchy-audio-tuning
@@ -123,6 +123,27 @@ tuning_present() {
   pactl list sinks short 2>/dev/null | awk '{print $2}' | grep -x "$sink_name" >/dev/null
 }
 
+# The physical sink the installed tuning is fronting. A shipped tuning declares
+# the sink it is built for, which is the most precise answer when it exists. A
+# tuning installed by hand has no such declaration -- tuning_match only looks
+# under tunings/ -- and answering nothing for it leaves the physical sink
+# selectable, so picking it bypasses the tuning: the opposite of what callers ask
+# this for. Resolve those from the running graph instead, where the tuning feeds
+# its physical sink through a stream of its own.
+fronted_physical_sink() {
+  local speakers
+  if speakers="$(tuned_hardware_sink)"; then
+    printf '%s\n' "$speakers"
+    return 0
+  fi
+  speakers="$(tuning_downstream_sink)"
+  # Nothing to resolve while the chain is idle or unlinked: the resolver then
+  # answers with the tuning sink itself, and reporting that would hide a sink
+  # callers must keep.
+  [[ -n $speakers && $speakers != "$sink_name" ]] || return 1
+  printf '%s\n' "$speakers"
+}
+
 # Only real application streams may be moved. A filter-chain's own output is also
 # a sink input but carries no application.name, and moving it would rewire the
 # tuning itself.
@@ -181,7 +202,7 @@ case "$action" in
     # "is a tuning in place", not "where should volume go" -- for the latter see
     # omarchy-audio-output-sink, which follows the current default output.
     tuning_present || exit 1
-    tuned_hardware_sink
+    fronted_physical_sink
     ;;
 
   status)
@@ -218,7 +239,10 @@ case "$action" in
       exit 0
     fi
 
-    speakers="$(tuned_hardware_sink)" || speakers=""
+    # Same resolution as fronted-sink: a hand-installed tuning has no declaration
+    # to read, and removing one without knowing its physical sink would leave the
+    # default sink pointing at a sink that no longer exists.
+    speakers="$(fronted_physical_sink)" || speakers=""
 
     systemctl --user disable --now "$unit_name" >/dev/null 2>&1
     rm -f "$fragment" "$host_config" "$unit" "$stale_shared"
